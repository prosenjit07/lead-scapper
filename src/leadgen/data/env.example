# Google Sheets (service account JSON key; share the sheet with the service account's email as Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
GOOGLE_SHEET_ID=

# Google Places API (New). Optional: the google_places source is skipped if empty.
GOOGLE_PLACES_API_KEY=

# REST API (`leads api`). Optional on localhost; required before binding to another host.
# Clients send it as the X-API-Key header. Generate one with: openssl rand -hex 32
LEADGEN_API_KEY=

# PostgreSQL (`store: postgres`; needs: uv sync --extra postgres, then `leads db migrate`).
# Local example: postgresql://leadgen:leadgen@localhost:5432/leadgen   (see docker-compose.yml)
DATABASE_URL=
